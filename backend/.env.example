# Frontend'in adresi — CORS bunu kullanır.
# Birden fazla adres virgülle yazılabilir (ör. vercel production + preview).
# Sondaki "/" önemli değil, otomatik temizlenir.
FRONTEND_URL=http://localhost:3000

# Oynayacak kişiler (en fazla 8). Lobide sadece bu isimler katılabilir.
PLAYER1_NAME=yasin
PLAYER2_NAME=yunus
PLAYER3_NAME=serkan
PLAYER4_NAME=zorbey

MIN_PLAYERS=2
MAX_PLAYERS=5

# PORT'u sunucu platformu (Render/Railway/Fly) kendisi verir — orada TANIMLAMA.
# Yerelde çalıştırırken istersen değiştirebilirsin.
# PORT=3001
